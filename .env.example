NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 공개 사이트 URL (사이트맵·정규 URL). 예: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# 문의·개인정보처리방침에 노출할 이메일
NEXT_PUBLIC_CONTACT_EMAIL=

# Google AdSense (ca-pub-xxxxxxxx). 발급 전까지 비워 두면 광고는 숨깁니다.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# 디스플레이 광고 슬롯. 애드센스에서 유닛을 만든 뒤 넣습니다.
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE=
